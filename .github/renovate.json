{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automergeStrategy": "rebase",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Keep uv patch updates separate from compatibility migrations",
      "matchPackageNames": ["astral-sh/uv"],
      "separateMinorPatch": true
    },
    {
      "description": "Automerge uv patch updates after required checks pass",
      "matchPackageNames": ["astral-sh/uv"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Require manual review for uv compatibility migrations",
      "matchPackageNames": ["astral-sh/uv"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "Refresh uv locks without narrowing PEP 621 dependency ranges",
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    }
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"]
}
